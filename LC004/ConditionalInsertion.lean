import LC004.ConditionalGrammarBridge

namespace LC004

/-- A backward-closed winning predicate inherits closure under an entire
    auxiliary erasure sequence, not just one pair/triple deletion. -/
theorem win_of_erases_of_lift {q : Nat}
    (Win : List (Fin q) → Prop)
    (lift : ∀ {u v : List (Fin q)}, SmallErase u v → Win v → Win u)
    {u v : List (Fin q)} (h : Erases u v) (hv : Win v) :
    Win u := by
  induction h with
  | refl _ => exact hv
  | next step rest ih => exact lift step ih

/-- A compositional consequence: one-step lifting implies insertion
    closure for ANY word erasable by pair/triple deletion, in ANY context.
    This remains CONDITIONAL until lift is proved for the actual game. -/
theorem win_insert_erasable_of_lift {q : Nat}
    (Win : List (Fin q) → Prop)
    (lift : ∀ {u v : List (Fin q)}, SmallErase u v → Win v → Win u)
    (left right middle : List (Fin q))
    (hmiddle : Erases middle [])
    (houter : Win (left ++ right)) :
    Win (left ++ middle ++ right) := by
  have hc := erases_context hmiddle left right
  have hz : Win (left ++ ([] : List (Fin q)) ++ right) := by
    simpa using houter
  exact win_of_erases_of_lift Win lift hc hz

/-- The same result specialized to words generated by the candidate grammar. -/
theorem win_insert_grammar_of_lift {q : Nat}
    (Win : List (Fin q) → Prop)
    (lift : ∀ {u v : List (Fin q)}, SmallErase u v → Win v → Win u)
    (left right middle : List (Fin q))
    (hmiddle : Grammar q middle)
    (houter : Win (left ++ right)) :
    Win (left ++ middle ++ right) := by
  exact win_insert_erasable_of_lift Win lift left right middle
    (grammar_erases_empty hmiddle) houter

end LC004
