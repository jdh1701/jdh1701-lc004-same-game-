theorem LC004.mem_solutionPaths_iff : ∀ (s : LC004.RunState) (p : List ℕ),
  p ∈ LC004.solutionPaths s ↔ LC004.SuccessfulPath s p :=
fun s p =>
  Eq.mpr (id (congrArg (fun _a => p ∈ _a ↔ LC004.SuccessfulPath s p) (LC004.solutionPaths.eq_1 s)))
    (Eq.mpr
      (id (congrArg (fun _a => _a ↔ LC004.SuccessfulPath s p) (propext (LC004.mem_pathSetFuel (List.length s) s p))))
      { mp := And.left, mpr := fun hp => ⟨hp, LC004.successfulPath_length_le_runs hp⟩ })
theorem LC004.uniqueSuccessfulPath_iff_card_solutionPaths : ∀ (s : LC004.RunState),
  LC004.UniqueSuccessfulPath s ↔ (LC004.solutionPaths s).card = 1 :=
fun s =>
  {
    mp := fun a =>
      Exists.casesOn a fun p h =>
        And.casesOn h fun hp huniq =>
          Finset.card_eq_one.mpr
            (Exists.intro p
              (Finset.ext fun q =>
                Eq.mpr (id (congrArg (fun _a => _a ↔ q ∈ {p}) (propext (LC004.mem_solutionPaths_iff s q))))
                  (Eq.mpr (id (congrArg (fun _a => LC004.SuccessfulPath s q ↔ _a) (propext Finset.mem_singleton)))
                    { mp := fun hq => huniq q hq, mpr := fun he => Eq.symm he ▸ hp }))),
    mpr := fun hcard =>
      Exists.casesOn (Finset.card_eq_one.mp hcard) fun p he =>
        let_fun hp :=
          (LC004.mem_solutionPaths_iff s p).mp
            (Eq.mpr (id (congrArg (fun _a => p ∈ _a) he)) (of_eq_true (Eq.trans _proof_1✝ (eq_self p))));
        Exists.intro p
          ⟨hp, fun q hq =>
            let_fun hmem := (LC004.mem_solutionPaths_iff s q).mpr hq;
            Finset.mem_singleton.mp (Eq.mp (congrArg (fun _a => q ∈ _a) he) hmem)⟩ }
