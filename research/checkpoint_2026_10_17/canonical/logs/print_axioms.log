theorem LC004.unique_successful_path_eq_medianPath : ∀ {s : LC004.RunState} {moves : List ℕ},
  LC004.Normalized s →
    LC004.UniqueSuccessfulPath s → LC004.SuccessfulPath s moves → moves = LC004.medianPath (List.length s) :=
fun {s} {moves} hn hu hp =>
  Exists.casesOn (LC004.successfulPath_has_completePath hp) fun p h =>
    And.casesOn h fun hcomplete hindices =>
      let_fun huc := LC004.uniqueSuccessfulPath_iff_uniqueCompletePath.mp hu;
      And.casesOn (LC004.unique_completePath_shape hcomplete hn huc) fun hind hsize =>
        let_fun hlength :=
          Or.casesOn hsize
            (fun he =>
              let_fun hbound := LC004.completePath_length_le hcomplete;
              Eq.mpr (id (congrArg (fun x => p.length = (x.length + 1) / 2) he))
                (Decidable.byContradiction fun a =>
                  LC004.unique_successful_path_eq_medianPath._proof_1 p
                    (Eq.mp (congrArg (fun x => p.length ≤ x.length) he) hbound) a))
            fun hsize =>
            Decidable.byContradiction fun a => LC004.unique_successful_path_eq_medianPath._proof_2 p hsize a;
        Trans.trans (Trans.trans (Eq.symm hindices) hind)
          (Eq.mpr (id (congrArg (fun _a => LC004.descendingChoices _a = LC004.medianPath (List.length s)) hlength))
            (Eq.refl (LC004.descendingChoices ((List.length s + 1) / 2))))
theorem LC004.unique_successful_path_length : ∀ {s : LC004.RunState} {moves : List ℕ},
  LC004.Normalized s →
    LC004.UniqueSuccessfulPath s → LC004.SuccessfulPath s moves → moves.length = (List.length s + 1) / 2 :=
fun {s} {moves} hn hu hp =>
  Eq.mpr
    (id
      (congrArg (fun _a => _a.length = (List.length s + 1) / 2) (LC004.unique_successful_path_eq_medianPath hn hu hp)))
    (LC004.descendingChoices_length ((List.length s + 1) / 2))
theorem LC004.unique_successful_path_medianPath_success : ∀ {s : LC004.RunState},
  LC004.Normalized s → LC004.UniqueSuccessfulPath s → LC004.SuccessfulPath s (LC004.medianPath (List.length s)) :=
fun {s} hn hu =>
  let_fun huniq := hu;
  Exists.casesOn hu fun moves h =>
    And.casesOn h fun hp right =>
      let_fun heq := LC004.unique_successful_path_eq_medianPath hn huniq hp;
      Eq.mp (congrArg (LC004.SuccessfulPath s) heq) hp
'LC004.unique_successful_path_eq_medianPath' depends on axioms: [propext, Classical.choice, Quot.sound]
