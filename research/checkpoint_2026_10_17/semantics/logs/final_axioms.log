theorem LC004.sixWay_all_proper_unique : ∀ (mask : Fin 63), LC004.UniqueSuccessfulPath (LC004.sixWayState ↑mask) :=
fun mask =>
  Exists.casesOn (LC004.sixWay_proper_heavier mask) fun i hi =>
    LC004.uniqueSuccessfulPath_of_heavier hi
      ((LC004.uniqueSuccessfulPath_iff_card_solutionPaths (LC004.sixWayState (63 - 2 ^ ↑i))).mpr
        (LC004.sixWay_maximal_proper_cards i))
      (LC004.sixWay_canonical_success
        ⟨↑mask, Decidable.byContradiction fun a => LC004.sixWay_all_proper_unique._proof_1 mask a⟩)
theorem LC004.fiveWay_all_proper_unique : ∀ (mask : Fin 31), LC004.UniqueSuccessfulPath (LC004.fiveWayState ↑mask) :=
fun mask =>
  Exists.casesOn (LC004.fiveWay_proper_heavier mask) fun i hi =>
    LC004.uniqueSuccessfulPath_of_heavier hi
      ((LC004.uniqueSuccessfulPath_iff_card_solutionPaths (LC004.fiveWayState (31 - 2 ^ ↑i))).mpr
        (LC004.fiveWay_maximal_proper_cards i))
      (LC004.fiveWay_canonical_success
        ⟨↑mask, Decidable.byContradiction fun a => LC004.fiveWay_all_proper_unique._proof_1 mask a⟩)
