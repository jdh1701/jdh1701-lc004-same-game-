theorem LC004.ordinaryStepAt_map_encode : ∀ (w : LC004.RawState) (i : ℕ),
  Option.map LC004.encode (LC004.ordinaryStepAt w i) = LC004.stepAt (LC004.encode w) i :=
fun w i => LC004.ordinaryStepAtFuel_map_encode (List.length w) w i (Nat.le_refl (List.length w))
theorem LC004.ordinary_unique_first_iff_path : ∀ (w : LC004.RawState),
  w ≠ [] →
    (LC004.OrdinaryUniqueSuccessfulFirst LC004.ordinaryStepAt w ↔
      LC004.OrdinaryUniqueSuccessfulPath LC004.ordinaryStepAt w) :=
fun w hne => LC004.ordinary_unique_first_iff_path_of_commute LC004.ordinaryStepAt LC004.ordinaryStepAt_map_encode w hne
theorem LC004.ordinary_unique_path_eq_medianPath : ∀ (w : LC004.RawState) (moves : List ℕ),
  LC004.OrdinaryUniqueSuccessfulPath LC004.ordinaryStepAt w →
    LC004.ordinaryFollow LC004.ordinaryStepAt w moves = some [] →
      moves = LC004.medianPath (List.length (LC004.encode w)) :=
fun w moves hu hp =>
  LC004.unique_successful_path_eq_medianPath (LC004.encode_normalized w)
    ((LC004.ordinaryUniquePath_iff LC004.ordinaryStepAt LC004.ordinaryStepAt_map_encode w).mp hu)
    ((LC004.ordinary_path_iff w moves).mp hp)
