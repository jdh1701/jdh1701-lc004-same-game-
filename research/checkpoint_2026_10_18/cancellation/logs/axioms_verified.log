LC004.four_block_barrier_zero.{u_1} {Q : Type u_1} [Fintype Q] [Lattice Q] (ps qs : List Q) (barrier y : Q)
  (hinv : ∀ (r : Q), (∃ p ∈ LC004.joinWitnessLists ps qs, p ≤ r) ↔ ∃ p ∈ LC004.joinWitnessLists ps qs, p ≤ r ⊓ barrier)
  (hy : ¬y ≤ barrier) :
  LC004.collectedCoeff
      (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2)
        (List.map (fun p => (LC004.quadAdjacent, p)) ps ++ List.map (fun q => (LC004.quadNested, q)) qs))
      (⊤, y) =
    0
LC004.noncrossing_interval_barrier.{u_1} {α : Type u_1} [LinearOrder α] (r : Setoid α) (hr : LC004.IsNoncrossing r)
  (a b x y : α) (hab : r a b) (hxy : r x y) (hax : ¬r a x) (hay : ¬r a y) : a < x ∧ x < b ↔ a < y ∧ y < b
