LC004.mem_fullBoardFourBlockFamily_iff {n : ℕ} (a b c d : Fin n) (hab : a < b) (hbc : b < c) (hcd : c < d)
  (r : Setoid (Fin n)) :
  r ∈ LC004.fullBoardFourBlockFamily a b c d hab hbc hcd ↔
    LC004.PairTriplePartition r ∧ r ≤ LC004.fullBoardPartition (LC004.quadSplitEquiv a b c d hab hbc hcd) (⊤, ⊤)
LC004.all_witness_four_block_zero {n : ℕ} (a b c d : Fin n) (hab : a < b) (hbc : b < c) (hcd : c < d)
  (p : Setoid (LC004.QuadRemainder a b c d)) (hp : ¬p ≤ Setoid.ker (LC004.remainderGapIndex a b c d)) :
  LC004.collectedCoeff (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) (LC004.allPairTripleWitnesses n))
      (LC004.fullBoardPartition (LC004.quadSplitEquiv a b c d hab hbc hcd) (⊤, p)) =
    0
LC004.all_witness_four_block_support {n : ℕ} (a b c d : Fin n) (hab : a < b) (hbc : b < c) (hcd : c < d)
  (p : Setoid (LC004.QuadRemainder a b c d))
  (hne :
    LC004.collectedCoeff (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) (LC004.allPairTripleWitnesses n))
        (LC004.fullBoardPartition (LC004.quadSplitEquiv a b c d hab hbc hcd) (⊤, p)) ≠
      0) :
  p ≤ Setoid.ker (LC004.remainderGapIndex a b c d)
