LC004.collected_union_product.{u_1, u_2} {P : Type u_1} {Q : Type u_2} [Fintype P] [Fintype Q] [SemilatticeSup P]
  [SemilatticeSup Q] (ps : List P) (qs : List Q) (x : P) (y : Q) :
  LC004.collectedCoeff
      (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) (List.flatMap (fun p => List.map (fun q => (p, q)) qs) ps)) (x, y) =
    LC004.collectedCoeff (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) ps) x *
      LC004.collectedCoeff (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) qs) y
LC004.pairTriple_iff_blocks.{u_1} {α : Type u_1} [LinearOrder α] [Finite α] (r s : Setoid α) (hrs : r ≤ s)
  (hs : LC004.IsNoncrossing s) :
  LC004.PairTriplePartition r ↔ ∀ (a : α), LC004.PairTriplePartition (LC004.restrictToBlock r s a)
