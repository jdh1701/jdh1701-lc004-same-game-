LC004.positional_regional_four_block_zero {n : ℕ} (a b c d : Fin n) (hab : a < b) (hbc : b < c) (hcd : c < d)
  (p : Setoid (LC004.QuadRemainder a b c d)) (hp : ¬p ≤ Setoid.ker (LC004.remainderGapIndex a b c d)) :
  LC004.collectedCoeff
      (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) (LC004.regionalFourBlockFamily (LC004.remainderGapIndex a b c d)))
      (⊤, p) =
    0
theorem LC004.positional_regional_four_block_zero : ∀ {n : ℕ} (a b c d : Fin n),
  a < b →
    b < c →
      c < d →
        ∀ (p : Setoid (LC004.QuadRemainder a b c d)),
          ¬p ≤ Setoid.ker (LC004.remainderGapIndex a b c d) →
            LC004.collectedCoeff
                (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2)
                  (LC004.regionalFourBlockFamily (LC004.remainderGapIndex a b c d)))
                (⊤, p) =
              0 :=
fun {n} a b c d hab hbc hcd p hp =>
  LC004.regional_four_block_zero (LC004.remainderGapIndex a b c d)
    (LC004.remainderGapIndex_noncrossing a b c d hab hbc hcd) p hp
