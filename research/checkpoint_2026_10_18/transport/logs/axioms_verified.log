LC004.fullBoard_four_block_zero {n : ℕ} (a b c d : Fin n) (hab : a < b) (hbc : b < c) (hcd : c < d)
  (p : Setoid (LC004.QuadRemainder a b c d)) (hp : ¬p ≤ Setoid.ker (LC004.remainderGapIndex a b c d)) :
  LC004.collectedCoeff (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) (LC004.fullBoardFourBlockFamily a b c d hab hbc hcd))
      (LC004.fullBoardPartition (LC004.quadSplitEquiv a b c d hab hbc hcd) (⊤, p)) =
    0
LC004.fullBoard_four_block_zero_of_coverage {n : ℕ} (a b c d : Fin n) (hab : a < b) (hbc : b < c) (hcd : c < d)
  (p : Setoid (LC004.QuadRemainder a b c d)) (hp : ¬p ≤ Setoid.ker (LC004.remainderGapIndex a b c d))
  (ws : List (Setoid (Fin n)))
  (hcover :
    ∀ x ≤ LC004.fullBoardPartition (LC004.quadSplitEquiv a b c d hab hbc hcd) (⊤, p),
      (∃ r ∈ ws, r ≤ x) ↔ ∃ r ∈ LC004.fullBoardFourBlockFamily a b c d hab hbc hcd, r ≤ x) :
  LC004.collectedCoeff (LC004.unionTerms (fun x1 x2 => x1 ⊔ x2) ws)
      (LC004.fullBoardPartition (LC004.quadSplitEquiv a b c d hab hbc hcd) (⊤, p)) =
    0
